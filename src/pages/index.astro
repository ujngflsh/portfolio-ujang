---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const featured =
  site.projects.find((project) => project.featured) ??
  site.projects[0];

const otherProjects = site.projects.filter(
  (project) => project !== featured
);

const hasValue = (value: string) =>
  Boolean(value?.trim() && !value.includes("[ISI DI SINI]"));

const hasTestimonials = site.testimonials.length > 0;

const validUrl = (value: string) =>
  /^https?:\/\//i.test(value);
---

<BaseLayout>
  <!-- NAVIGATION -->
  <header class="sticky top-0 z-30 border-b border-slate-700/80 bg-[#101820]/95 text-white backdrop-blur">
    <nav
      class="container-shell flex min-h-16 items-center justify-between gap-4"
      aria-label="Main navigation"
    >
      <a
        href="#top"
        class="shrink-0 font-bold tracking-tight no-underline"
        aria-label={`${site.brand} home`}
      >
        {site.brand}<span class="text-[#65d6b0]">.</span>
      </a>

      <!-- Desktop navigation -->
      <div class="hidden items-center gap-6 text-sm md:flex">
        <a href="#work" class="nav-link">Work</a>
        <a href="#services" class="nav-link">Services</a>
        <a href="#about" class="nav-link">About</a>
        <a href="#contact" class="nav-link">Contact</a>
      </div>

      <!-- Desktop CTA -->
      {validUrl(site.links.upwork) ? (
        <a
          class="btn-primary hidden !min-h-10 !px-3 !py-2 text-sm sm:inline-flex"
          href={site.links.upwork}
          target="_blank"
          rel="noopener noreferrer"
        >
          Hire me on Upwork ↗
        </a>
      ) : (
        <a
          class="btn-primary hidden !min-h-10 !px-3 !py-2 text-sm md:inline-flex"
          href="#contact"
        >
          Let's talk ↗
        </a>
      )}

      <!-- Mobile menu -->
      <details class="mobile-menu relative md:hidden">
        <summary
          class="flex min-h-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-600 px-3 text-sm font-semibold transition-colors hover:border-[#65d6b0] hover:text-[#65d6b0]"
          aria-label="Open navigation menu"
        >
          <span class="menu-open-label">Menu</span>
          <span class="menu-close-label">Close</span>
          <span class="ml-2" aria-hidden="true">☰</span>
        </summary>

        <div class="absolute right-0 top-full mt-3 flex w-56 flex-col gap-1 rounded-xl border border-slate-700 bg-[#18232d] p-3 shadow-xl">
          <a href="#work" class="mobile-nav-link">Work</a>
          <a href="#services" class="mobile-nav-link">Services</a>
          <a href="#about" class="mobile-nav-link">About</a>
          <a href="#contact" class="mobile-nav-link">Contact</a>

          <div class="my-2 border-t border-slate-700"></div>

          {validUrl(site.links.upwork) ? (
            <a
              class="btn-primary text-center text-sm"
              href={site.links.upwork}
              target="_blank"
              rel="noopener noreferrer"
            >
              Hire me on Upwork ↗
            </a>
          ) : (
            <a class="btn-primary text-center text-sm" href="#contact">
              Let's talk ↗
            </a>
          )}
        </div>
      </details>
    </nav>
  </header>

  <main id="main">
    <!-- HERO -->
    <section id="top" class="overflow-hidden bg-[#101820] text-white">
      <div class="container-shell grid min-h-[610px] items-center gap-12 py-16 md:grid-cols-[1.15fr_.85fr] md:py-20">
        <div>
          <p class="mb-5 flex items-center gap-2 text-sm text-slate-300">
            <span class="h-2 w-2 rounded-full bg-[#65d6b0]"></span>
            {site.role}
            <span class="text-slate-500">·</span>
            <span>React &amp; Tailwind CSS</span>
          </p>

          <h1 class="max-w-3xl text-4xl font-bold leading-[1.08] tracking-[-.045em] sm:text-5xl lg:text-7xl">
            {site.hero.headline}
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
            {site.hero.supporting}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            {validUrl(site.links.upwork) ? (
              <a
                class="btn-primary"
                href={site.links.upwork}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.hero.primaryLabel} ↗
              </a>
            ) : (
              <a class="btn-primary" href="#contact">
                {site.hero.primaryLabel} ↗
              </a>
            )}

            {hasValue(site.email) ? (
              <a
                class="btn-secondary btn-secondary-on-dark"
                href={`mailto:${site.email}?subject=${encodeURIComponent("Project brief for Ujang")}`}
              >
                {site.hero.secondaryLabel}
              </a>
            ) : (
              <a
                class="btn-secondary btn-secondary-on-dark"
                href="#contact"
              >
                {site.hero.secondaryLabel}
              </a>
            )}
          </div>

          <div class="mt-10 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-400">
            {site.stack.slice(0, 4).map((item) => (
              <span class="mono">{item}</span>
            ))}
          </div>
        </div>

        <!-- Profile image -->
        <div class="relative mx-auto w-full max-w-sm">
          <div class="absolute -right-4 -top-4 h-28 w-28 rounded-3xl border border-[#526bff]/60"></div>

          <div class="relative overflow-hidden rounded-2xl border border-slate-700 bg-[#18232d] p-4">
            {site.photo ? (
              <img
                src={site.photo}
                alt={`Portrait of ${site.name}`}
                width="640"
                height="760"
                fetchpriority="high"
                class="aspect-[4/5] w-full rounded-xl object-cover"
              />
            ) : (
              <div class="flex aspect-[4/5] flex-col justify-between rounded-xl bg-[radial-gradient(ellipse_at_top_right,_#334e70,_#202d39_55%)] p-6">
                <span class="mono text-xs tracking-[.18em] text-slate-400">
                  UJANGDEV / PROFILE
                </span>

                <div>
                  <span class="mb-4 flex h-20 w-20 items-center justify-center rounded-2xl border border-white/20 bg-[#65d6b0] text-4xl font-bold text-[#101820]">
                    {site.name.slice(0, 1)}
                  </span>

                  <p class="text-3xl font-bold">{site.name}</p>
                  <p class="mt-1 text-slate-300">{site.role}</p>

                  <p class="mt-5 max-w-xs text-sm leading-6 text-slate-400">
                    Focused on thoughtful UI, responsive layouts, and clean
                    front-end implementation.
                  </p>
                </div>
              </div>
            )}

            <div class="flex items-center justify-between gap-3 px-1 pb-1 pt-4 text-sm">
              <span class="text-slate-300">
                Building useful interfaces.
              </span>
              <span class="mono text-[#65d6b0]">UI → code</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    
<!-- PROJECTS -->
<section id="work" class="section-pad bg-[#101820] text-white">
  <div class="container-shell">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow mb-2">Selected work</p>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Projects, with the thinking behind them.
        </h2>
      </div>

      <p class="max-w-md text-slate-300">
        A few examples of interface work. Project labels and outcomes
        should stay accurate and verifiable.
      </p>
    </div>

    {featured && (
      <article class="grid items-start gap-8 lg:grid-cols-[1.15fr_.85fr]">
        <div class="browser-frame">
          <div class="browser-bar">
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-address">
              {featured.liveUrl || "Project preview"}
            </span>
          </div>

          {featured.image ? (
            <img
              src={featured.image}
              alt={`Screenshot of ${featured.name}`}
              width="1200"
              height="850"
              loading="lazy"
              decoding="async"
              class="aspect-[6/4] w-full object-cover"
            />
          ) : (
            <div class="flex aspect-[6/4] flex-col justify-between bg-[#e9edf2] p-6 text-slate-800 sm:p-10">
              <div class="flex items-center justify-between">
                <span class="font-bold">{featured.name}</span>
                <span class="mono text-xs text-slate-500">PREVIEW</span>
              </div>

              <div>
                <div class="h-4 w-2/3 rounded bg-slate-300"></div>
                <div class="mt-3 h-4 w-1/2 rounded bg-slate-300"></div>
                <div class="mt-7 h-10 w-32 rounded bg-[#526bff]"></div>
              </div>

              <p class="text-sm text-slate-500">
                Interface direction · Concept preview
              </p>
            </div>
          )}
        </div>

        <div>
          <p class="eyebrow text-slate-400">{featured.type}</p>
          <h3 class="mt-2 text-2xl font-bold text-white">
            {featured.name}
          </h3>

          <p class="mt-3 text-lg leading-relaxed text-slate-300">
            {featured.summary}
          </p>

          <dl class="mt-7 space-y-5">
            <div>
              <dt class="font-bold text-white">The problem</dt>
              <dd class="mt-1 text-slate-300">{featured.problem}</dd>
            </div>

            <div>
              <dt class="font-bold text-white">What I built</dt>
              <dd class="mt-1 text-slate-300">{featured.solution}</dd>
            </div>

            <div>
              <dt class="font-bold text-white">Outcome</dt>
              <dd class="mt-1 text-slate-300">{featured.result}</dd>
            </div>
          </dl>

          <div class="mt-5 flex flex-wrap gap-2">
            {featured.stack.map((tech) => (
              <span class="rounded-full border border-slate-600 bg-[#18232d] px-3 py-1 text-sm text-[#65d6b0]">
                {tech}
              </span>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap gap-4 text-sm font-bold">
            {validUrl(featured.liveUrl) && (
              <a
                class="text-[#65d6b0] hover:text-white"
                href={featured.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View live ↗
              </a>
            )}

            {validUrl(featured.repoUrl) && (
              <a
                class="text-[#65d6b0] hover:text-white"
                href={featured.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View source ↗
              </a>
            )}
          </div>
        </div>
      </article>
    )}

    {otherProjects.length > 0 && (
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        {otherProjects.map((project) => (
          <article class="border-t border-slate-700 pt-5">
            <div class="browser-frame mb-5">
              <div class="browser-bar">
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-address">
                  {project.liveUrl || "Project preview"}
                </span>
              </div>

              {project.image ? (
                <img
                  src={project.image}
                  alt={`Screenshot of ${project.name}`}
                  width="900"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[3/2] w-full object-cover"
                />
              ) : (
                <div class="flex aspect-[3/2] flex-col justify-between bg-[#e9edf2] p-6 text-slate-800">
                  <span class="mono text-xs text-slate-500">
                    {project.type}
                  </span>

                  <div>
                    <div class="h-3 w-3/4 rounded bg-slate-300"></div>
                    <div class="mt-3 h-3 w-1/2 rounded bg-slate-300"></div>
                    <div class="mt-6 h-8 w-24 rounded bg-[#526bff]"></div>
                  </div>

                  <span class="text-sm text-slate-500">
                    Interface direction · Concept preview
                  </span>
                </div>
              )}
            </div>

            <p class="eyebrow text-slate-400">{project.type}</p>

            <h3 class="mt-1 text-xl font-bold text-white">
              {project.name}
            </h3>

            <p class="mt-2 leading-relaxed text-slate-300">
              {project.summary}
            </p>

            <div class="mt-4 space-y-3 text-sm text-slate-300">
              <p>
                <strong class="text-white">Built:</strong> {project.solution}
              </p>
              <p>
                <strong class="text-white">Outcome:</strong> {project.result}
              </p>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <span class="rounded-full border border-slate-600 bg-[#18232d] px-3 py-1 text-sm text-[#65d6b0]">
                  {tech}
                </span>
              ))}
            </div>

            <div class="mt-4 flex gap-4 text-sm font-bold">
              {validUrl(project.liveUrl) && (
                <a
                  class="text-[#65d6b0] hover:text-white"
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live project ↗
                </a>
              )}

              {validUrl(project.repoUrl) && (
                <a
                  class="text-[#65d6b0] hover:text-white"
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Repository ↗
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>


    
<!-- SERVICES -->
<section
  id="services"
  class="section-pad border-y border-slate-700 bg-[#101820] text-white"
  aria-labelledby="services-title"
>
  <div class="container-shell">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <p class="eyebrow mb-2">Services</p>

        <h2
          id="services-title"
          class="max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl"
        >
          Front-end support for products that need to work beautifully.
        </h2>
      </div>

      <p class="max-w-md leading-relaxed text-slate-300">
        Clear scope, thoughtful implementation, and responsive interfaces
        built around what your project actually needs.
      </p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {site.services.map((service, i) => (
        <article
          class="flex h-full flex-col rounded-xl border border-slate-700 bg-[#18232d] p-6 transition duration-200 hover:-translate-y-1 hover:border-[#65d6b0]/70 sm:p-7"
        >
          <div class="flex items-center justify-between gap-3">
            <span class="mono text-xs tracking-wider text-[#65d6b0]">
              0{i + 1} / SERVICE
            </span>
            <span class="h-px flex-1 bg-slate-700"></span>
          </div>

          <h3 class="mt-6 text-xl font-bold tracking-tight text-white">
            {service.title}
          </h3>

          <p class="mt-3 leading-relaxed text-slate-300">
            {service.description}
          </p>

          <div class="mt-7">
            <h4 class="text-sm font-semibold text-white">What’s included</h4>
            <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-slate-300">
              {service.deliverables.map((item) => (
                <li class="flex gap-2.5">
                  <span class="mt-px shrink-0 text-[#65d6b0]" aria-hidden="true">↗</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-auto border-t border-slate-700 pt-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              A good fit for
            </p>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">
              {service.bestFor}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-col gap-3 rounded-xl border border-slate-700/80 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p class="max-w-xl text-sm leading-relaxed text-slate-300">
        Not sure which service fits your project? Share what you’re building
        and we can define the right scope together.
      </p>
      <a
        href="#contact"
        class="btn-secondary btn-secondary-on-dark w-full sm:w-auto"
      >
        Discuss your project ↗
      </a>
    </div>
  </div>
</section>


    <!-- ABOUT -->
  
<!-- ABOUT -->
<section id="about" class="section-pad bg-[#101820] text-white">
  <div class="container-shell grid gap-10 md:grid-cols-[.8fr_1.2fr]">
    <div>
      {site.photo ? (
        <img
          src={site.photo}
          alt={`Portrait of ${site.name}`}
          width="640"
          height="760"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full max-w-sm rounded-2xl object-cover"
        />
      ) : (
        <div class="flex aspect-[4/5] max-w-sm flex-col justify-between rounded-2xl bg-[#18232d] p-6">
          <span class="mono text-sm text-slate-300">
            A LITTLE ABOUT ME
          </span>

          <span class="text-7xl font-bold text-[#65d6b0]">
            {site.name.slice(0, 1)}
          </span>

          <span class="text-sm text-slate-300">
            Portrait can be added when the original photo is available.
          </span>
        </div>
      )}
    </div>

    <div>
      <p class="eyebrow mb-2">About</p>

      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        A developer who cares about the details and the handoff.
      </h2>

      <p class="mt-6 whitespace-pre-line text-lg leading-8 text-slate-300">
        {site.bio}
      </p>

      <div class="mt-7 grid gap-5 sm:grid-cols-2">
        <div>
          <h3 class="font-bold text-white">Working principles</h3>

          <ul class="mt-3 space-y-2 text-slate-300">
            {site.workingStyle.map((item) => (
              <li class="flex gap-2">
                <span class="shrink-0 text-[#65d6b0]">↗</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="font-bold text-white">Stack</h3>

          <div class="mt-3 flex flex-wrap gap-2">
            {site.stack.map((item) => (
              <span class="rounded-full border border-slate-600 bg-[#18232d] px-3 py-1 text-sm text-[#65d6b0]">
                {item}
              </span>
            ))}
          </div>

          <div class="mt-5 space-y-2 text-sm text-slate-300">
            {hasValue(site.location) && (
              <p><strong class="text-white">Location:</strong> {site.location}</p>
            )}

            {hasValue(site.timezone) && (
              <p><strong class="text-white">Time zone:</strong> {site.timezone}</p>
            )}

            {hasValue(site.languages) && (
              <p><strong class="text-white">Languages:</strong> {site.languages}</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


    <!-- TESTIMONIALS -->
    {hasTestimonials && (
      <section
        class="section-pad border-y border-slate-200 bg-white"
        aria-labelledby="testimonials-title"
      >
        <div class="container-shell">
          <p class="eyebrow mb-2">Testimonials</p>

          <h2 id="testimonials-title" class="text-3xl font-bold">
            What collaborators say.
          </h2>

          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {site.testimonials.map((item) => (
              <figure class="border-l-2 border-[#65d6b0] pl-5">
                <blockquote class="text-lg">
                  “{item.quote}”
                </blockquote>

                <figcaption class="mt-4 text-sm text-slate-600">
                  <strong class="text-[#101820]">{item.name}</strong>
                  · {item.role}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

   
<!-- CONTACT -->
<section id="contact" class="section-pad bg-[#101820] text-white">
  <div class="container-shell grid gap-12 md:grid-cols-[.85fr_1.15fr]">
    <div>
      <p class="mb-2 text-sm font-semibold text-[#65d6b0]">
        Contact
      </p>

      <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Have a project in mind?
      </h2>

      <p class="mt-5 max-w-md text-lg leading-relaxed text-slate-300">
        {site.contactNote}
      </p>

      <div class="mt-8 space-y-3 text-slate-300">
        {hasValue(site.email) && (
          <p>
            <a href={`mailto:${site.email}`} class="text-[#65d6b0] underline underline-offset-4 hover:text-white">
              {site.email}
            </a>
          </p>
        )}

        {validUrl(site.links.upwork) && (
          <p>
            <a href={site.links.upwork} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[#65d6b0]">
              Upwork ↗
            </a>
          </p>
        )}

        {validUrl(site.links.linkedin) && (
          <p>
            <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[#65d6b0]">
              LinkedIn ↗
            </a>
          </p>
        )}

        {validUrl(site.links.github) && (
          <p>
            <a href={site.links.github} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-[#65d6b0]">
              GitHub ↗
            </a>
          </p>
        )}

        {validUrl(site.links.cv) && (
          <p>
            <a href={site.links.cv} download class="underline underline-offset-4 hover:text-[#65d6b0]">
              Download CV ↓
            </a>
          </p>
        )}
      </div>
    </div>

   <form
  id="contact-form"
  class="rounded-2xl border border-slate-700 bg-[#18232d] p-5 text-white shadow-xl sm:p-7"
  novalidate
  data-endpoint="https://formspree.io/f/mrppgvrj"
>
      <div class="grid gap-5">
        <div>
          <label for="name" class="mb-2 block font-semibold text-slate-100">
            Name
          </label>

          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            minlength="2"
            maxlength="100"
            placeholder="Your name"
            class="min-h-12 w-full rounded-lg border border-slate-600 bg-[#101820] px-3 text-white placeholder:text-slate-500 focus:border-[#65d6b0] focus:outline-none focus:ring-2 focus:ring-[#65d6b0]/20"
          />
        </div>

        <div>
          <label for="email" class="mb-2 block font-semibold text-slate-100">
            Email
          </label>

          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
            placeholder="you@example.com"
            class="min-h-12 w-full rounded-lg border border-slate-600 bg-[#101820] px-3 text-white placeholder:text-slate-500 focus:border-[#65d6b0] focus:outline-none focus:ring-2 focus:ring-[#65d6b0]/20"
          />
        </div>

