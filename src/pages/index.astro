  <!-- CONTACT FORM AND MOBILE MENU SCRIPT -->
  <script>
    const form = document.querySelector("#contact-form");
    const status = document.querySelector("#form-status");

    if (
      form instanceof HTMLFormElement &&
      status instanceof HTMLElement
    ) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!form.reportValidity()) {
          status.textContent =
            "Please check the highlighted fields and try again.";
          status.className = "text-sm text-red-700";
          return;
        }

        const button = form.querySelector(
          'button[type="submit"]'
        );

        if (
          button instanceof HTMLButtonElement &&
          button.disabled
        ) {
          return;
        }

        const endpoint = form.dataset.endpoint?.trim();
        const emailAddress = form.dataset.email?.trim();

        const formData = new FormData(form);

        const name = String(
          formData.get("name") ?? ""
        ).trim();

        const email = String(
          formData.get("email") ?? ""
        ).trim();

        const message = String(
          formData.get("message") ?? ""
        ).trim();

        // Email fallback when no endpoint is configured.
        if (!endpoint) {
          if (emailAddress) {
            const subject = encodeURIComponent(
              `Project brief from ${name}`
            );

            const body = encodeURIComponent(
              `Name: ${name}\nEmail: ${email}\n\n${message}`
            );

            status.textContent =
              "Your email app will open. Please review and send your message.";

            status.className = "text-sm text-amber-800";

            window.location.href =
              `mailto:${emailAddress}?subject=${subject}&body=${body}`;
          } else {
            status.textContent =
              "The form is not configured yet. Please contact me through another available channel.";

            status.className = "text-sm text-red-700";
          }

          return;
        }

        if (button instanceof HTMLButtonElement) {
          button.disabled = true;
          button.textContent = "Sending...";
        }

        status.textContent = "Sending your message...";
        status.className = "text-sm text-slate-600";

        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              name,
              email,
              message,
            }),
          });

          if (!response.ok) {
            throw new Error("Request failed");
          }

          form.reset();

          status.textContent =
            "Message sent successfully. Thank you for reaching out.";

          status.className = "text-sm text-green-800";
        } catch {
          status.textContent =
            "Sorry, your message could not be sent. Please try again or contact me by email.";

          status.className = "text-sm text-red-700";
        } finally {
          if (button instanceof HTMLButtonElement) {
            button.disabled = false;
            button.textContent = "Send project brief ↗";
          }
        }
      });
    }

   
const mobileMenu = document.querySelector(".mobile-menu");

if (mobileMenu) {
  mobileMenu.addEventListener("click", (event) => {
    const target = event.target;

    if (
      target instanceof Element &&
      target.closest(".mobile-nav-link")
    ) {
      mobileMenu.removeAttribute("open");
    }
  });
}

  </script>
